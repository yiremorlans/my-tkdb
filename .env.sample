APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
# Public HTTPS URL this app is reachable at (e.g. your ngrok URL or production
# domain). Used to build image URLs for backgrounds/characters so Discord can
# load them, via app.js's /assets static route.
BASE_URL=<YOUR_PUBLIC_URL>

# Discord user id of the bot owner. Unlocks the owner-only `/encdev` and
# `/missiondev` commands (trigger encounters and missions manually while
# testing). Leave unset to disable them — the commands stay registered but
# refuse everyone.
OWNER_DISCORD_ID=<YOUR_DISCORD_USER_ID>

# Timezone the bot judges "evening" against for `_PM` backgrounds and evening
# dialogue (Discord doesn't give us per-user timezones). One zone for all users.
# Any IANA name; app.js defaults to America/Chicago if this is unset.
TZ=America/Chicago

# Hangout Activity (docs/hangout-activity.md §6). DISCORD_CLIENT_SECRET is the
# OAuth2 client secret from the Developer Portal (OAuth2 → Client Secret),
# used to exchange the Activity's sign-in code. ACTIVITY_SESSION_SECRET signs
# the Activity's 1h session tokens: any long random string, e.g. the output
# of `openssl rand -hex 32`. Changing it signs everyone out of open Activities.
DISCORD_CLIENT_SECRET=<YOUR_CLIENT_SECRET>
ACTIVITY_SESSION_SECRET=<RANDOM_32_BYTE_HEX>
